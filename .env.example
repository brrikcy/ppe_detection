# Moondream Cloud API key (https://moondream.ai)
MOONDREAM_API_KEY=
# Moondream API base URL (default: Moondream Cloud). Use another provider or a self-hosted server here.
# MOONDREAM_ENDPOINT=https://api.moondream.ai/v1

# Optional overrides
# Comma separated PPE items every worker must wear (helmet, vest, gloves, boots, goggles, mask)
REQUIRED_PPE=helmet,vest
# Check each worker's PPE every N seconds (people are tracked on every frame)
ANALYSIS_INTERVAL_SEC=1.0
# Parallel Moondream requests
MAX_WORKERS=4
# YOLO weights for person tracking (default: models/yolo11n.pt)
# PERSON_MODEL=models/yolo11n.pt
